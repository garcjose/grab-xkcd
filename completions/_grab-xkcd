#compdef grab-xkcd

autoload -U is-at-least

_grab-xkcd() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-t+[Set a connection timeout]:TIMEOUT:_default' \
'--timeout=[Set a connection timeout]:TIMEOUT:_default' \
'-o+[Print output in a format]:OUTPUT:(json text)' \
'--output=[Print output in a format]:OUTPUT:(json text)' \
'-n+[The comic to load]:NUM:_default' \
'--num=[The comic to load]:NUM:_default' \
'-s[Save image file to current directory]' \
'--save[Save image file to current directory]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
}

(( $+functions[_grab-xkcd_commands] )) ||
_grab-xkcd_commands() {
    local commands; commands=()
    _describe -t commands 'grab-xkcd commands' commands "$@"
}

if [ "$funcstack[1]" = "_grab-xkcd" ]; then
    _grab-xkcd "$@"
else
    compdef _grab-xkcd grab-xkcd
fi
